{
  "name": "@memphis-chains/memphisos",
  "version": "0.1.0",
  "description": "MemphisOS: Hybrid Rust kernel and TypeScript orchestrator for secure agent execution",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "memphis": "bin/memphis.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "node scripts/setup-githooks.mjs",
    "dev": "tsx src/index.ts",
    "cli": "tsx src/infra/cli/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:ts",
    "test:ts": "vitest run",
  "test:ops-artifacts": "vitest run tests/ops/incident-bundle-exporter.test.ts tests/ops/incident-bundle-manifest-verify.test.ts tests/ops/rotate-key-bundle.test.ts tests/ops/strict-incident-handoff.test.ts tests/ops/strict-handoff-docs-contract.test.ts tests/ops/strict-handoff-schemas.test.ts tests/ops/strict-handoff-fixture-validator.test.ts tests/ops/strict-handoff-workflow-contract.test.ts tests/ops/strict-handoff-validator-json-gate.test.ts tests/ops/release-draft-validator-metadata-contract.test.ts tests/ops/release-draft-docs-contract.test.ts tests/ops/release-draft-validator-metadata-validator.test.ts tests/ops/release-preflight.test.ts tests/ops/release-preflight-ci-triage-contract.test.ts tests/ops/release-preflight-ci-triage-docs-contract.test.ts",
    "test:chaos": "vitest run tests/unit/wal-chaos-gate.test.ts",
    "test:rust": "bash -lc 'command -v cargo >/dev/null 2>&1 || source $HOME/.cargo/env; cargo test --workspace'",
    "build:rust": "bash -lc 'command -v cargo >/dev/null 2>&1 || source $HOME/.cargo/env; cargo build --workspace'",
    "build": "npm run build:rust && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "pack:dry-run": "npm pack --dry-run",
    "ops:protect-main": "./scripts/enforce-branch-protection.sh",
    "ops:verify-main-protection": "./scripts/verify-branch-protection.sh",
    "ops:drill-guards": "tsx scripts/drill-guard-failures.mts",
    "ops:export-incident-bundle": "tsx scripts/export-incident-bundle.mts",
    "ops:strict-incident-handoff": "tsx scripts/strict-incident-handoff.mts",
    "ops:validate-strict-handoff-fixtures": "tsx scripts/validate-strict-handoff-fixtures.mts",
    "ops:validate-release-draft-validator-metadata": "tsx scripts/validate-release-draft-validator-metadata.mts",
    "ops:release-preflight": "tsx scripts/release-preflight.mts",
    "ops:query-cognitive-reports": "tsx scripts/query-cognitive-reports.mts",
    "ops:verify-incident-manifest": "tsx scripts/verify-incident-manifest.mts",
    "ops:rotate-key-bundle": "tsx scripts/rotate-key-bundle.mts"
  },
  "keywords": [
    "memphisos",
    "agent-os",
    "rust",
    "typescript",
    "orchestrator"
  ],
  "author": "Memphis-Chains",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Memphis-Chains/MemphisOS.git"
  },
  "homepage": "https://github.com/Memphis-Chains/MemphisOS#readme",
  "bugs": {
    "url": "https://github.com/Memphis-Chains/MemphisOS/issues"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^25.3.5",
    "@types/prompts": "^2.4.9",
    "ajv": "^8.17.1",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "better-sqlite3": "^12.6.2",
    "chalk": "^5.6.2",
    "cli-progress": "^3.12.0",
    "commander": "^14.0.3",
    "dotenv": "^17.3.1",
    "fastify": "^5.8.2",
    "pino": "^10.3.1",
    "prompts": "^2.4.2",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "ollama": "^0.5.14"
  },
  "peerDependencies": {
    "ollama": ">=0.5.0"
  }
}
